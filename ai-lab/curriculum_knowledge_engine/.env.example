# --- LLM ---
CKE_ANTHROPIC_API_KEY=your-api-key-here
CKE_CLAUDE_MODEL=claude-opus-5

# --- Backends: local (default, no extra services needed) ---
CKE_VECTOR_BACKEND=chroma
CKE_GRAPH_BACKEND=networkx

# --- Backends: production (uncomment + `docker compose up`) ---
# CKE_VECTOR_BACKEND=pgvector
# CKE_POSTGRES_DSN=postgresql://cke:cke@localhost:5432/cke
# CKE_GRAPH_BACKEND=neo4j
# CKE_NEO4J_URI=bolt://localhost:7687
# CKE_NEO4J_USER=neo4j
# CKE_NEO4J_PASSWORD=change-me

# --- App ---
CKE_APP_ENV=development
CKE_LOG_LEVEL=INFO
