GOOGLE_API_KEY=...
OPENAI_API_KEY=sk-...
EDUCA_MODEL=gemini-3.7-flash

# Only needed if you switch agent.py/team.py/materials_agent.py back to Claude.
# ANTHROPIC_API_KEY=sk-ant-...

# Vector store for uploaded course materials (backend/app/knowledge.py).
# `docker compose up -d` in backend/ starts a matching local Postgres.
DATABASE_URL=postgresql+psycopg://educa:educa@localhost:55432/educa

# rag/embeddings.py - defaults to a local sentence-transformers model, no
# key needed. Set to "openai" (with a funded OPENAI_API_KEY above) to use
# OpenAI embeddings instead -- see backend/rag/README.md.
# RAG_EMBEDDER_PROVIDER=local

# curriculum_ai/ -- document ingestion foundation.
# `docker compose up -d` also starts redis + minio matching these defaults.
REDIS_URL=redis://localhost:6379/0
CURRICULUM_STORAGE_BACKEND=s3
CURRICULUM_S3_ENDPOINT_URL=http://localhost:9000
CURRICULUM_S3_BUCKET=educa-curriculum-documents
CURRICULUM_S3_ACCESS_KEY=educa
CURRICULUM_S3_SECRET_KEY=educa123
# Unset CURRICULUM_S3_ENDPOINT_URL (and point the access/secret keys at
# real AWS credentials) to use production S3 instead of local MinIO.

# Signs auth JWTs (backend/app/auth/security.py). Falls back to an
# insecure dev default if unset -- always set a real one outside local dev.
JWT_SECRET=change-me-to-a-long-random-string

# Secret key (sk_...) from the Liveblocks dashboard, for the lecturers' chat
# auth endpoint (backend/app/liveblocks_auth.py). Server-only -- never expose
# this to the frontend.
LIVEBLOCKS_API_KEY=sk_...

# Where agent run/approval state and Ask AI history live (backend/app/agents/storage.py).
# Defaults to the Postgres above; set to "sqlite" to use the old local file tmp/educa_agent.db
# (e.g. to read conversations recorded before the move to Postgres).
# AGENT_DB=postgres

# Daily token cap per student for the Teaching Assistant (backend/app/usage.py). 0 disables.
# TA_DAILY_TOKEN_CAP=200000

# Start the study-guide analysis automatically when an uploaded PDF finishes processing.
# STUDY_GUIDE_AUTO_ANALYZE=true

# Student notes AI (backend/student_ai): daily token cap per student for ambient note
# suggestions and the AI helpers. 0 disables the cap.
# STUDENT_AI_DAILY_TOKEN_CAP=300000

# Module story videos (backend/module_video): daily token cap per teacher for script
# drafting, and the render provider. "mock" (default) produces a storyboard, not a video.
# STORY_DAILY_TOKEN_CAP=200000
# VIDEO_PROVIDER=mock
