GOOGLE_API_KEY=...
OPENAI_API_KEY=sk-...
EDUCA_MODEL=gemini-3.7-flash

# Only needed if you switch agent.py/team.py/materials_agent.py back to Claude.
# ANTHROPIC_API_KEY=sk-ant-...

# Vector store for uploaded course materials (backend/app/knowledge.py).
# `docker compose up -d` in backend/ starts a matching local Postgres.
DATABASE_URL=postgresql+psycopg://educa:educa@localhost:55432/educa

# Signs auth JWTs (backend/app/auth/security.py). Falls back to an
# insecure dev default if unset -- always set a real one outside local dev.
JWT_SECRET=change-me-to-a-long-random-string

# Secret key (sk_...) from the Liveblocks dashboard, for the lecturers' chat
# auth endpoint (backend/app/liveblocks_auth.py). Server-only -- never expose
# this to the frontend.
LIVEBLOCKS_API_KEY=sk_...
